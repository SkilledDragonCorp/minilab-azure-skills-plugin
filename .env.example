# Keyless CI needs none of these. Optional live Azure MCP only.
DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
AZURE_MCP_COLLECT_TELEMETRY=false
NPM_CONFIG_REGISTRY=https://registry.npmjs.org


# Prefer `az login` / OIDC with Reader role over client secrets.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=
